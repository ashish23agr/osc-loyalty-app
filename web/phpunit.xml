<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Fake Shopify credentials so Context::initialize() runs during tests.
             SCOPES and SHOPIFY_API_VERSION deliberately come from .env, so the
             config/shopify.app.toml consistency test checks the real values. -->
        <env name="SHOPIFY_API_KEY" value="test-api-key"/>
        <!-- 32 characters. firebase/php-jwt v7 refuses an HMAC key shorter than
             32 bytes, so a short secret makes every session-token test fail with
             DomainException rather than an auth error. Real Shopify client
             secrets are 32 hex characters, so this matches production. -->
        <env name="SHOPIFY_API_SECRET" value="a1b2c3d4e5f60718293a4b5c6d7e8f90"/>
        <env name="SHOPIFY_APP_URL" value="https://oxford-staging.test"/>
    </php>
</phpunit>
