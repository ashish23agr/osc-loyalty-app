{
  "_meta": {
    "purpose": "The single source of truth for every loyalty calculation, consumed by BOTH test suites: PHPUnit in web/ and Vitest in extensions/voucher-discount/. The redemption ladder is implemented twice - once in PHP for the quote, once in Wasm for the discount function - and two implementations of one business rule will drift. Changing a rule means changing this file, which fails whichever side has not been updated.",
    "money": "All monetary values are integer pence. All point values are integers.",
    "sections": {
      "balance_derivation": "M2, sprint 1. floor(available / threshold) * value.",
      "lot_allocation": "M2, sprint 1. FIFO consumption across earn lots.",
      "adjustment": "M2, sprint 1. Manual adjustments and their effect on buckets.",
      "redemption_ladder": "M6/M7, sprint 3. The ordered limit ladder: eligible subtotal -> minimum basket -> configured cap -> strictly below basket value -> round down to the voucher increment. Implemented TWICE - PHP for the quote, TypeScript compiled to Wasm for the discount function - and this file is what stops the two drifting.",
      "refund_reversal": "M8, sprint 2. D9c cumulative floor: floor(points * cumulative_refunded / order_eligible) minus what is already posted. Never round a single refund's own fraction.",
      "refund_reversal_sequences": "M8, sprint 2. D9c consequences: any split of a refund totals what one refund would have, and a full refund always nets to zero remaining.",
      "lot_release": "M8, sprint 2. D9a: restored points go back to the lots the redemption drew from, oldest first, capped at what each lot gave, so a redeem-and-refund cycle cannot extend a point's life.",
      "earning": "M3, sprint 2. D3 earn base: line totals after discount, ex tax, ex shipping; qualification by collection or tag; floored to whole points ONCE per order."
    },
    "source": "Privilege Club Blueprint Rev 2, sections 05 and 06; decisions D1, D2, D8, D9 and D9a-D9d."
  },
