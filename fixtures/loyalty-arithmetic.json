  "refund_reversal": [
    {
      "name": "Worked example: a 20 pound refund of an 80 pound order",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 2000,
        "already_reversed": 0,
        "already_restored": 0
