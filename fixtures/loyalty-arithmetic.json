      "expect": {
        "reverse": 20,
        "restore": 50,
        "cumulative_reversed": 20,
        "cumulative_restored": 50,
        "full_refund": false
      },
      "note": "A clean quarter. 25% of 80 earned and 25% of 200 redeemed, both exact."
    },
    {
      "name": "The 21 pound refund, p = 0.2625, where flooring actually bites",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 2100,
        "already_reversed": 0,
        "already_restored": 0
      },
      "expect": {
        "reverse": 21,
        "restore": 52,
        "cumulative_reversed": 21,
        "cumulative_restored": 52,
        "full_refund": false
      },
      "note": "floor(200 * 2100 / 8000) = floor(52.5) = 52. The half point is not given away."
    },
    {
      "name": "A full refund reverses everything and restores everything",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 8000,
        "already_reversed": 0,
        "already_restored": 0
      },
      "expect": {
        "reverse": 80,
        "restore": 200,
        "cumulative_reversed": 80,
        "cumulative_restored": 200,
        "full_refund": true
      }
    },
    {
      "name": "An over-refund is clamped to the order, not extrapolated",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 9000,
        "already_reversed": 0,
        "already_restored": 0
      },
      "expect": {
        "reverse": 80,
        "restore": 200,
        "cumulative_reversed": 80,
        "cumulative_restored": 200,
        "full_refund": true
      },
      "note": "Shopify permits refunding more than the order; the answer is still everything, never more."
    },
    {
      "name": "Nothing was redeemed, so there is nothing to restore",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 0,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 2100,
        "already_reversed": 0,
        "already_restored": 0
      },
      "expect": {
        "reverse": 21,
        "restore": 0,
        "cumulative_reversed": 21,
        "cumulative_restored": 0,
        "full_refund": false
      }
    },
    {
      "name": "Nothing was earned, but a redemption still comes back",
      "rules": "launch",
      "input": {
        "points_earned": 0,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 2100,
        "already_reversed": 0,
        "already_restored": 0
      },
      "expect": {
        "reverse": 0,
        "restore": 52,
        "cumulative_reversed": 0,
        "cumulative_restored": 52,
        "full_refund": false
      }
    },
    {
      "name": "A redelivered refund computes an increment of zero",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 2100,
        "already_reversed": 21,
        "already_restored": 52
      },
      "expect": {
        "reverse": 0,
        "restore": 0,
        "cumulative_reversed": 21,
        "cumulative_restored": 52,
        "full_refund": false
      },
      "note": "The cumulative total is already posted, so the increment is nothing. Idempotency before the key is even consulted."
    },
    {
      "name": "A smaller corrected total never takes points back from the member",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "cumulative_refunded_pence": 700,
        "already_reversed": 21,
        "already_restored": 52
      },
      "expect": {
        "reverse": 0,
        "restore": 0,
        "cumulative_reversed": 7,
        "cumulative_restored": 17,
        "full_refund": false
      },
      "note": "max(0, target - already). A revised-down refund posts nothing rather than an entry that claws back."
    }
  ],
  "refund_reversal_sequences": [
    {
      "name": "Three 7 pound refunds equal one 21 pound refund, entry for entry",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "refunds_cumulative_pence": [
          700,
          1400,
          2100
        ]
      },
      "expect": {
        "steps": [
          {
            "cumulative_refunded_pence": 700,
            "reverse": 7,
            "restore": 17
          },
          {
            "cumulative_refunded_pence": 1400,
            "reverse": 7,
            "restore": 18
          },
          {
            "cumulative_refunded_pence": 2100,
            "reverse": 7,
            "restore": 17
          }
        ],
        "total_reversed": 21,
        "total_restored": 52,
        "full_refund": false
      },
      "per_refund_floor_would_total": {
        "reversed": 21,
        "restored": 51
      },
      "note": "The point of the cumulative floor. Per-refund flooring restores 51 and the member is a point down for returning things separately."
    },
    {
      "name": "A full refund after a partial nets to exactly zero remaining",
      "rules": "launch",
      "input": {
        "points_earned": 80,
        "points_redeemed": 200,
        "order_eligible_pence": 8000,
        "refunds_cumulative_pence": [
          2100,
          8000
        ]
      },
      "expect": {
        "steps": [
          {
            "cumulative_refunded_pence": 2100,
            "reverse": 21,
            "restore": 52
          },
          {
            "cumulative_refunded_pence": 8000,
            "reverse": 59,
            "restore": 148
          }
        ],
        "total_reversed": 80,
        "total_restored": 200,
        "full_refund": true
      },
      "per_refund_floor_would_total": {
        "reversed": 80,
        "restored": 199
      },
      "note": "21 + 59 = 80 earned reversed; 52 + 148 = 200 redeemed restored. No residue, whatever route was taken."
    },
    {
