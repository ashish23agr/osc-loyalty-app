        "unallocated": 150
      }
    },
    {
      "name": "Nothing to consume allocates nothing",
      "lots": [
        {
          "points": 100,
          "already_allocated": 0
        }
      ],
      "consume": 0,
      "expect": {
        "allocations": [
          0
        ],
