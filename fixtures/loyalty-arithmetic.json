      "expect": {
        "allocations": [
          200
        ],
        "unallocated": 0
      }
    },
    {
      "name": "FIFO: the oldest lot is drained before the next is touched",
      "lots": [
        {
          "points": 100,
          "already_allocated": 0
        },
        {
          "points": 300,
          "already_allocated": 0
        }
      ],
      "consume": 250,
      "expect": {
        "allocations": [
          100,
          150
        ],
        "unallocated": 0
      }
    },
    {
      "name": "A partly consumed lot only offers what remains",
      "lots": [
        {
          "points": 100,
          "already_allocated": 80
        },
        {
          "points": 300,
          "already_allocated": 0
        }
      ],
      "consume": 100,
      "expect": {
        "allocations": [
          20,
          80
        ],
        "unallocated": 0
      }
    },
    {
      "name": "Exhausted lots are skipped entirely",
      "lots": [
        {
          "points": 100,
          "already_allocated": 100
