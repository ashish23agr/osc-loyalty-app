        {
          "points": 50,
          "already_allocated": 0
        }
      ],
      "consume": 50,
      "expect": {
        "allocations": [
          0,
          50
        ],
        "unallocated": 0
      }
    },
    {
      "name": "Consuming more than the lots hold reports the shortfall rather than inventing points",
      "lots": [
        {
          "points": 100,
          "already_allocated": 0
